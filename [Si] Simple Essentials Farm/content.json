{
	"Format": "2.9.0",

	"ConfigSchema": {

		"GreenRainDebris": {
			"AllowValues": "true, false",
			"Default": "true",
			"Description": "When disabled, green rain trees and weeds won't spawn on the farm during green rain days."
		},

		"Stumps": {
			"AllowValues": "true, false",
			"Default": "true",
			"Description": "Toggles the daily stumps."
		},

		"Quarry": {
			"AllowValues": "true, false",
			"Default": "true",
			"Description": "Toggles the quarry."
		},

		"Minipond": {
			"AllowValues": "true, false",
			"Default": "true",
			"Description": "Toggles the miniature pond."
		},

		"Upperpond": {
			"AllowValues": "true, false",
			"Default": "true",
			"Description": "Toggles the upper pond."
		},

		"Lowerpond": {
			"AllowValues": "true, false",
			"Default": "true",
			"Description": "Toggles the lower pond."
		},
	},
	
	"Changes": [

		// Load assets
		{
			"Action": "Load",
			"Target": "Mods/{{ModId}}/icon",
			"FromFile": "assets/farm_icon.png",
		},
		{
			"Action": "Load",
			"Target": "Maps/{{ModId}}_Farm",
			"FromFile": "assets/Farm.tmx",
		},

		// Not loading farm world map for now

		// Load strings
		{
			"Action": "EditData",
			"Target": "Strings/UI",
			"Entries": {
				"{{ModId}}_Farm": "{{i18n:Si.SEF.name}}_{{i18n:Si.SEF.descrip}}",
			},
		},

		// Add farm
		{
			"Action": "EditData",
			"Target": "Data/AdditionalFarms",
			"Entries": {
				"{{ModId}}_Farm": {
					"Id": "{{ModId}}_Farm",
					"TooltipStringPath": "Strings/UI:{{ModId}}_Farm",
					"MapName": "{{ModId}}_Farm",
					"IconTexture": "Mods/{{ModId}}/icon",
					// "WorldMapTexture": "", // Meh for now
				},
			},
		},

		// Add location data
		{
			"Action": "EditData",
			"Target": "Data/Locations",
			"Entries": {
				"Farm_{{ModId}}_Farm": {
					"DisplayName": "[LocalizedText Strings\\StringsFromCSFiles:MapPage.cs.11064 [EscapedText [FarmName]]]",
					"DefaultArrivalTile": {"X": 64, "Y": 15},
					"CanHaveGreenRainSpawns": "{{GreenRainDebris}}",
					// Crab pot data
					"FishAreas": {
						"Ponds": {
							"CrabPotFishTypes": [ "freshwater" ],
						},
					},
					// Fish data
					"Fish": [
						{
							"Id": "LOCATION_FISH Mountain BOBBER_X BOBBER_Y WATER_DEPTH",
							"ItemId": "LOCATION_FISH Mountain BOBBER_X BOBBER_Y WATER_DEPTH",
							"Chance": 0.8,
							"ApplyDailyLuck": true,
						},
					],
					// Artifact data
					"ArtifactSpots": [
                        {
                            "Id": "Coal",
                            "ItemId": "(O)382",
                            "Chance": 0.5,
                            "MaxStack": 3
                        },
						{
                            "Id": "MixedSeeds",
                            "ItemId": "(O)770",
                            "Chance": 0.1,
                            "MaxStack": 2
                        },
						{
                            "Id": "SpringSeeds",
                            "ItemId": "(O)495",
                            "Chance": 0.1,
                            "MaxStack": 2,
                            "Condition": "SEASON Spring",
                        },
                        {
                            "Id": "SummerSeeds",
                            "ItemId": "(O)496",
                            "Chance": 0.1,
                            "MaxStack": 2,
                            "Condition": "SEASON Summer",
                        },
                        {
                            "Id": "FallSeeds",
                            "ItemId": "(O)497",
                            "Chance": 0.1,
                            "MaxStack": 2,
                            "Condition": "SEASON Fall",
                        },
                        {
                            "Id": "WinterSeeds",
                            "ItemId": "(O)498",
                            "Chance": 0.1,
                            "MaxStack": 2,
                            "Condition": "SEASON Winter",
                        },
						{
                            "Id": "IridiumOre",
                            "ItemId": "(O)386",
                            "Chance": 0.05,
                            "MaxStack": 1
                        },
					],
				},
			},
		},

		// Patch stumps

		{
			"Action": "EditMap",
			"Target": "Maps/{{ModId}}_Farm",
			"MapProperties": {
				"Stumps": "36 44 3 39 44 3 42 44 3 45 44 3 48 44 3 37 46 3 40 46 3 43 46 3 46 46 3 49 46 3"
			},
			"When": {
				"Stumps": true,
			},
		},

		{
			"Action": "EditMap",
			"Target": "Maps/{{ModId}}_Farm",
			"FromFile": "assets/stumps.tmx",
			"ToArea": { "X": 36, "Y": 44, "Width": 14, "Height": 3 },
			"PatchMode": "Overlay",
			"When": {
				"Stumps": true,
			},
		},

		// Patch quarry

		{
			"Action": "EditMap",
			"Target": "Maps/{{ModId}}_Farm",
			"MapProperties": {
				"SpawnMountainFarmOreRect": "54 45 11 3"
			},
			"When": {
				"Quarry": true,
			},
		},

		{
			"Action": "EditMap",
			"Target": "Maps/{{ModId}}_Farm",
			"FromFile": "assets/quarry.tmx",
			"ToArea": { "X": 52, "Y": 43, "Width": 15, "Height": 6 },
			"PatchMode": "Overlay",
			"When": {
				"Quarry": true,
			},
		},

		// Patch ponds

		{
			"Action": "EditMap",
			"Target": "Maps/{{ModId}}_Farm",
			"FromFile": "assets/minipond.tmx",
			"ToArea": { "X": 39, "Y": 18, "Width": 5, "Height": 2 },
			"PatchMode": "Replace",
			"When": {
				"Minipond": true,
			},
		},

		{
			"Action": "EditMap",
			"Target": "Maps/{{ModId}}_Farm",
			"FromFile": "assets/upperpond.tmx",
			"ToArea": { "X": 5, "Y": 15, "Width": 10, "Height": 9 },
			"PatchMode": "Replace",
			"When": {
				"Upperpond": true,
			},
		},

		{
			"Action": "EditMap",
			"Target": "Maps/{{ModId}}_Farm",
			"FromFile": "assets/lowerpond.tmx",
			"ToArea": { "X": 4, "Y": 41, "Width": 6, "Height": 7 },
			"PatchMode": "Replace",
			"When": {
				"Lowerpond": true,
			},
		},

	]
}